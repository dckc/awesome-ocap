{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-fun1-alt",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "alias": {
    "capnweb": "./node_modules/capnweb/dist/index-workers.js"
  },
  "build": {
    "command": "mkdir -p public/vendor && cp node_modules/capnweb/dist/index.js public/vendor/capnweb.js"
  },
  "assets": {
    "directory": "public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORAGE",
        "class_name": "Storage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": ["Storage"]
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-fun1",
  "main": "src/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-19",
  "alias": {
    "capnweb": "./node_modules/capnweb/dist/index-workers.js"
  },
  "build": {
    "command": "mkdir -p public/vendor && cp node_modules/capnweb/dist/index.js public/vendor/capnweb.js && node build-facet.js"
  },
  "assets": {
    "directory": "public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FACET_SUPERVISOR",
        "class_name": "FacetSupervisor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": ["FacetSupervisor"]
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
